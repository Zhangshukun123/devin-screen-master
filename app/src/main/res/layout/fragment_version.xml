<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hjq.shape.layout.ShapeLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:shape="rectangle">

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_10"
            android:text="版本"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="@dimen/dp_10"
            app:shape="rectangle"
            app:shape_radius="4dp"
            app:shape_solidColor="#14D5B7FF">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:src="@mipmap/ic_logo_main"
                    app:layout_constraintDimensionRatio="H,62:11"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="name"
                    android:textColor="@color/white"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="7sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUIVersionLeft"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="UI Ver："
                    android:textColor="@color/white"
                    android:textSize="7sp" />

                <TextView
                    android:id="@+id/tvUIVersion"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="1.0.0.0"
                    android:textColor="@color/white"
                    android:textSize="7sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSwVersionLeft"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="SW Ver："
                    android:textColor="@color/white"
                    android:textSize="7sp" />

                <TextView
                    android:id="@+id/tvSwVersion"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="1.0.0.0"
                    android:textColor="@color/white"
                    android:textSize="7sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </com.hjq.shape.layout.ShapeLinearLayout>

    </com.hjq.shape.layout.ShapeLinearLayout>
</RelativeLayout>