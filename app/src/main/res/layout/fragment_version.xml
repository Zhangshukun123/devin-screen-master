<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hjq.shape.layout.ShapeLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:shape="rectangle">

        <TextView
            android:id="@+id/tvVersion"
            style="@style/text_title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_10"
            android:text="版本" />

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="@dimen/dp_10"
            app:shape="rectangle"
            app:shape_radius="4dp"
            app:shape_solidColor="#14D5B7FF">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_logo_main"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/text_normal"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="name" />

                <!--                <TextView-->
                <!--                    style="@style/text_normal_bold"-->
                <!--                    android:layout_width="50dp"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:text="@string/app_name" />-->
                <TextView
                    style="@style/text_normal_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name_red" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUIVersionLeft"
                    style="@style/text_normal"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="APP Ver：" />

                <TextView
                    android:id="@+id/tvUIVersion"
                    style="@style/text_normal_bold"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="1.0.0.0" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSwVersionLeft"
                    style="@style/text_normal"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="SW Ver：" />

                <TextView
                    android:id="@+id/tvSwVersion"
                    style="@style/text_normal_bold"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="1.0.0.0" />

            </LinearLayout>


        </com.hjq.shape.layout.ShapeLinearLayout>

    </com.hjq.shape.layout.ShapeLinearLayout>
</RelativeLayout>