<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2860"
    android:orientation="vertical"
    tools:ignore="MissingConstraints">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/title_color"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivFinish"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:paddingVertical="12dp"
                android:paddingLeft="20dp"
                android:paddingRight="10dp"
                android:src="@mipmap/icon_w_finish" />

            <LinearLayout
                android:id="@+id/llDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingRight="10dp">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:gravity="center_vertical"
                    android:paddingRight="5dp"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivDeviceName"
                    android:layout_width="11dp"
                    android:layout_height="6dp"
                    android:src="@mipmap/icon_sanjiao" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/modelName"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14dp" />

        <ImageView
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@mipmap/pic_titlelogo" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/layout_logo_top_left" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_machine"
            app:layout_constraintBottom_toTopOf="@id/ll_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guild_line_ver_center"
            app:layout_constraintTop_toBottomOf="@id/view_top_end" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_top_end"
            android:layout_width="237dp"
            android:layout_height="77dp"
            android:background="@mipmap/bg_main_top_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/logo_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_40"
                android:src="@mipmap/ic_music"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.diwen.liliao.utils.ReplaceSelectorImageView
                android:id="@+id/ivSong1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="20dp"
                android:src="@mipmap/icon_song1"
                app:layout_constraintBottom_toBottomOf="@id/ivSong2"
                app:layout_constraintEnd_toStartOf="@id/ivSong2"
                app:layout_constraintTop_toTopOf="@id/ivSong2" />

            <com.diwen.liliao.utils.ReplaceSelectorImageView
                android:id="@+id/ivSong2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="20dp"
                android:src="@mipmap/icon_song2"
                app:layout_constraintBottom_toBottomOf="@id/ivSong3"
                app:layout_constraintEnd_toStartOf="@id/ivSong3"
                app:layout_constraintTop_toTopOf="@id/ivSong3" />

            <com.diwen.liliao.utils.ReplaceSelectorImageView
                android:id="@+id/ivSong3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:src="@mipmap/icon_song3"
                app:layout_constraintEnd_toEndOf="@id/seekbar"
                app:layout_constraintTop_toTopOf="@id/logo_music" />

            <SeekBar
                android:id="@+id/seekbar"
                style="@android:style/Widget.SeekBar"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="3dp"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginEnd="20dp"
                android:background="@null"
                android:max="31"
                android:min="0"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="50"
                android:progressDrawable="@drawable/layer_list_progress_drawable_1"
                android:thumb="@drawable/shape_progressbar_thumb"
                app:layout_constraintBottom_toBottomOf="@id/logo_music"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/logo_music"
                tools:ignore="MissingConstraints" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@mipmap/bg_main_bottom_left"
                android:orientation="horizontal"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivSetting"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="7.5dp"
                        android:src="@mipmap/icon_setting" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivRecord"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="7.5dp"
                        android:src="@mipmap/ic_record" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivMaiChong"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="7.5dp"
                        android:src="@mipmap/ic_maichong" />

                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvAirBlower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="16dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="@dimen/dp_10"
                    android:src="@mipmap/ic_fengshan_jian" />

                <SeekBar
                    android:id="@+id/seekbar_fengshan"
                    style="@android:style/Widget.SeekBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_10"
                    android:layout_weight="1"
                    android:background="@null"
                    android:max="31"
                    android:min="0"
                    android:paddingStart="0dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="13dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/layer_list_progress_drawable_1"
                    android:thumb="@drawable/shape_progressbar_thumb" />

                <ImageView
                    android:id="@+id/fenshan"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7.5dp"
                    android:src="@mipmap/ic_fengshan_add" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@mipmap/bg_main_bottom_right"
                android:orientation="horizontal"
                android:paddingStart="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivPhone"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="7.5dp"
                        android:src="@mipmap/icon_phoneline" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivBl"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="7.5dp"
                        android:src="@mipmap/icon_lanta" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:padding="7.5dp"
                        android:src="@mipmap/icon_wificonnect" />

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_start"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="@dimen/dp_40"
            android:background="@mipmap/bg_start"
            app:layout_constraintBottom_toTopOf="@id/ll_bottom"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="@id/guild_line_ver_center">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@mipmap/ic_start" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_start_left"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:background="@mipmap/bg_time_control"
            app:layout_constraintBottom_toBottomOf="@id/rl_start"
            app:layout_constraintEnd_toStartOf="@id/rl_start"
            app:layout_constraintTop_toTopOf="@id/rl_start">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@mipmap/icon_jian" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_start_right"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:background="@mipmap/bg_time_control"
            app:layout_constraintBottom_toBottomOf="@id/rl_start"
            app:layout_constraintStart_toEndOf="@id/rl_start"
            app:layout_constraintTop_toTopOf="@id/rl_start">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@mipmap/icon_add" />
        </RelativeLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guild_line_ver_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />


        <com.hjq.shape.layout.ShapeConstraintLayout
            android:id="@+id/shapeMine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginRight="15dp"
            android:padding="7dp"
            app:layout_constraintRight_toLeftOf="@+id/shapeMao"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_endColor="#FEE3F9"
            app:shape_radius="5dp"
            app:shape_startColor="#DFB6FD">

            <com.hjq.shape.view.ShapeImageView
                android:id="@+id/ivAdd"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:src="@mipmap/icon_add"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_radius="3dp"
                app:shape_solidColor="@color/white"
                app:shape_solidPressedColor="@color/pressedColor" />

            <com.hjq.shape.view.ShapeImageView
                android:id="@+id/ivmiue"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:src="@mipmap/icon_jian"
                app:layout_constraintBottom_toBottomOf="@+id/tvMine"
                app:layout_constraintLeft_toLeftOf="@+id/ivAdd"
                app:shape_radius="3dp"
                app:shape_solidColor="@color/white"
                app:shape_solidPressedColor="@color/pressedColor" />


        </com.hjq.shape.layout.ShapeConstraintLayout>

        <LinearLayout
            android:id="@+id/shapeMao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/rl_start"
            app:layout_constraintEnd_toEndOf="@id/guild_line_ver_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.hjq.shape.view.ShapeView
                android:layout_width="6dp"
                android:layout_height="6dp"
                app:shape_radius="10dp"
                app:shape_solidColor="@color/white" />

            <com.hjq.shape.view.ShapeView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                app:shape_radius="10dp"
                app:shape_solidColor="@color/white" />
        </LinearLayout>

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvMine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_10"
            android:gravity="center"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="37sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/shapeMao"
            app:layout_constraintEnd_toStartOf="@id/shapeMao"
            app:layout_constraintTop_toTopOf="@id/shapeMao" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvSeconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:gravity="center"
            android:text="00"
            android:textColor="@color/white"
            android:textSize="37sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/shapeMao"
            app:layout_constraintStart_toEndOf="@id/shapeMao"
            app:layout_constraintTop_toTopOf="@id/shapeMao" />

        <com.hjq.shape.layout.ShapeConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:padding="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/shapeMine"
            app:layout_constraintLeft_toRightOf="@+id/shapeMao"
            app:layout_constraintTop_toTopOf="@+id/shapeMine"
            app:shape_endColor="#FEE3F9"
            app:shape_radius="5dp"
            app:shape_startColor="#DFB6FD">

            <com.hjq.shape.view.ShapeImageView
                android:id="@+id/ivAdd1"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:src="@mipmap/icon_add"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shape_radius="3dp"
                app:shape_solidColor="@color/white"
                app:shape_solidPressedColor="@color/pressedColor" />

            <com.hjq.shape.view.ShapeImageView
                android:id="@+id/ivmiue1"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:src="@mipmap/icon_jian"
                app:layout_constraintBottom_toBottomOf="@+id/tvSeconds"
                app:layout_constraintLeft_toLeftOf="@+id/ivAdd1"
                app:shape_radius="3dp"
                app:shape_solidColor="@color/white"
                app:shape_solidPressedColor="@color/pressedColor" />


        </com.hjq.shape.layout.ShapeConstraintLayout>

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvStart"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:paddingHorizontal="37dp"
            android:textColor="@color/white"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shapeMine"
            app:shape_endColor="#D691FD"
            app:shape_radius="40dp"
            app:shape_solidPressedColor="@color/pressedColor"
            app:shape_startColor="#4976FB"
            app:shape_strokeColor="#D7E6FB"
            app:shape_strokeWidth="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mesreList"
            android:layout_width="370dp"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>