<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_pagebg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/title_color">

        <ImageView
            android:id="@+id/ivFinish"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:paddingLeft="32dp"
            android:paddingVertical="12dp"
            android:src="@mipmap/icon_w_finish" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:paddingRight="32dp"
            android:text="301按摩室"
            android:textColor="@color/white"
            android:textSize="12dp" />   <ImageView
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:src="@mipmap/pic_titlelogo" />
    </RelativeLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="197dp"
        android:layout_margin="32dp">
        <net.center.blurview.ShapeBlurView
            android:layout_width="match_parent"
            android:layout_height="197dp"
            app:blur_corner_radius="15dp"
            app:blur_overlay_color="#400D46C8"
            app:blur_radius="5dp" />

        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="33dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设备名称："
                    android:textColor="@color/white"
                    android:textSize="11dp" />

                <com.hjq.shape.view.ShapeEditText
                    android:id="@+id/evDeviceName"
                    android:layout_width="292dp"
                    android:layout_height="27dp"
                    android:layout_marginLeft="10dp"
                    android:background="@null"
                    android:hint=" "
                    android:paddingLeft="22dp"
                    android:textColor="@color/white"
                    android:textColorHint="#B9CCF9"
                    android:textSize="11dp"
                    app:shape_radius="5dp"
                    app:shape_solidColor="#40BCD4F6"
                    app:shape_strokeColor="#BCD4F6"
                    app:shape_strokeWidth="0.5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWifiName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIFI名称："
                    android:textColor="@color/white"
                    android:textSize="11dp" />

                <com.hjq.shape.view.ShapeEditText
                    android:id="@+id/evWifiName"
                    android:layout_width="292dp"
                    android:layout_height="27dp"
                    android:layout_marginLeft="10dp"
                    android:background="@null"
                    android:hint=" "
                    android:paddingLeft="22dp"
                    android:textColor="@color/white"
                    android:textColorHint="#B9CCF9"
                    android:textSize="11dp"
                    app:shape_radius="5dp"
                    app:shape_solidColor="#40BCD4F6"
                    app:shape_strokeColor="#BCD4F6"
                    app:shape_strokeWidth="0.5dp" />

            </LinearLayout>

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIFI密码："
                    android:textColor="@color/white"
                    android:textSize="11dp" />

                <com.hjq.shape.view.ShapeEditText
                    android:id="@+id/evPwd"
                    android:layout_width="292dp"
                    android:layout_height="27dp"
                    android:layout_marginLeft="10dp"
                    android:background="@null"
                    android:hint=" "
                    android:paddingLeft="22dp"
                    android:textColor="@color/white"
                    android:textColorHint="#B9CCF9"
                    android:textSize="11dp"
                    app:shape_radius="5dp"
                    app:shape_solidColor="#40BCD4F6"
                    app:shape_strokeColor="#BCD4F6"
                    app:shape_strokeWidth="0.5dp" />

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tvSave"
        app:shape_radius="5dp"
        android:paddingHorizontal="33dp"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="25dp"
        android:gravity="center"
        android:text="保存"
        app:shape_solidColor="@color/white"
        app:shape_solidPressedColor="@color/bg_color" />



</LinearLayout>