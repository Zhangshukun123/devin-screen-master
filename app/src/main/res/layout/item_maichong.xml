<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    tools:ignore="MissingConstraints">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv1"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="全部"
            android:textColor="@color/white"
            android:textSize="8sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/llHZ"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/tv1"
            app:layout_constraintRight_toLeftOf="@+id/llKong"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="4dp"
            app:shape_solidColor="#1AFFFFFF">

            <TextView
                android:id="@+id/tv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="sasa"
                android:textColor="@color/white"
                android:textSize="8sp" />

            <com.diwen.liliao.utils.CustomEditText
                android:id="@+id/evHz"
                android:layout_width="100dp"
                android:layout_height="25dp"
                android:background="@null"
                android:gravity="center"
                android:hint=" "
                android:imeOptions="actionDone"
                android:inputType="numberSigned"
                android:text="1000"
                android:textColor="@color/white"
                android:textColorHint="#B9CCF9"
                android:textSize="8sp" />

        </com.hjq.shape.layout.ShapeLinearLayout>

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/llKong"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/llHZ"
            app:layout_constraintRight_toLeftOf="@+id/rlChose"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="4dp"
            app:shape_solidColor="#1AFFFFFF">

            <TextView
                android:id="@+id/tv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="占空比："
                android:textColor="@color/white"
                android:textSize="8sp"

                app:layout_constraintLeft_toRightOf="@+id/llHZ"
                app:layout_constraintRight_toLeftOf="@+id/evKong" />

            <com.diwen.liliao.utils.CustomEditText
                android:id="@+id/evKong"
                android:layout_width="100dp"
                android:layout_height="25dp"
                android:background="@null"
                android:gravity="center"
                android:hint=" "
                android:imeOptions="actionDone"
                android:inputType="numberSigned"
                android:text="100"
                android:textColor="@color/white"
                android:textColorHint="#B9CCF9"
                android:textSize="8sp"
                app:layout_constraintLeft_toRightOf="@+id/tv3"
                app:layout_constraintRight_toLeftOf="@+id/ivChose" />

        </com.hjq.shape.layout.ShapeLinearLayout>

        <com.hjq.shape.layout.ShapeRelativeLayout
            android:id="@+id/rlChose"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/llKong"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="4dp"
            app:shape_solidColor="#1AFFFFFF">

            <ImageView
                android:id="@+id/ivChose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@mipmap/icon_ran_chose" />

        </com.hjq.shape.layout.ShapeRelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>