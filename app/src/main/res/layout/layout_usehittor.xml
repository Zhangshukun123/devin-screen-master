<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_pagebg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/title_color">

        <ImageView
            android:id="@+id/ivFinish"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:paddingVertical="12dp"
            android:paddingLeft="32dp"
            android:src="@mipmap/icon_w_finish" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:paddingRight="32dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="12dp" />   <ImageView
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:src="@mipmap/pic_titlelogo" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAllTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="累计工作时间："
            android:textColor="@color/white"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/tvWorkAllTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#ffffffff"
            android:textSize="14dp" />


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="105dp"
        android:layout_marginTop="18dp">

        <net.center.blurview.ShapeBlurView
            android:layout_width="match_parent"
            android:layout_height="186dp"
            app:blur_corner_radius="6dp"
            app:blur_overlay_color="#400D46C8"
            app:blur_radius="5dp" />

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="186dp"
            android:orientation="vertical"
            app:shape_radius="6dp"
            app:shape_solidColor="@color/bg00"
            app:shape_strokeColor="#80FFFFFF"
            app:shape_strokeWidth="1dp">

            <com.hjq.shape.layout.ShapeFrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="45dp"
                app:shape_endColor="#A064FD"
                app:shape_startColor="#418DDE"
                app:shape_strokeColor="#80FFFFFF"
                app:shape_strokeWidth="1dp"
                app:shape_topLeftRadius="6dp"
                app:shape_topRightRadius="6dp">

                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvXuhao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="序     号："
                    android:textColor="@color/white"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/tvNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12dp" />
            </com.hjq.shape.layout.ShapeFrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="45dp">

                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始时间："
                    android:textColor="@color/white"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/evStartTime"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12dp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#80FFFFFF" />


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="45dp">

                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束时间："
                    android:textColor="@color/white"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/evEndTime"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12dp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#80FFFFFF" />


            <com.hjq.shape.layout.ShapeFrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="45dp"
                app:shape_bottomLeftRadius="6dp"
                app:shape_bottomRightRadius="6dp"
                app:shape_solidColor="@color/bg00">

                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvDeviceTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用时长："
                    android:textColor="@color/white"
                    android:textSize="12dp" />

                <TextView
                    android:id="@+id/evDeviceTime"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="12dp" />
            </com.hjq.shape.layout.ShapeFrameLayout>
        </com.hjq.shape.layout.ShapeLinearLayout>


    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="50dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="6dp"
            android:text="上一条"
            android:textColor="@color/white"
            app:shape_radius="5dp"
            app:shape_solidColor="#1a000000"
            app:shape_strokeColor="#80FFFFFF"
            app:shape_strokeWidth="1dp" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="6dp"
            android:text="下一条"
            android:textColor="@color/white"
            app:shape_radius="5dp"
            app:shape_solidColor="#1a000000"
            app:shape_strokeColor="#80FFFFFF"
            app:shape_strokeWidth="1dp" />


    </LinearLayout>

</LinearLayout>