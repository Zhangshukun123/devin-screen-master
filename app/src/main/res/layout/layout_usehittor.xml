<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/layout_logo_top_left" />

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            app:shape="rectangle"
            app:shape_radius="4dp"
            app:shape_solidColor="#14D5B7FF">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    android:id="@+id/tvRecord"
                    style="@style/text_title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记录" />

                <LinearLayout
                    android:layout_width="@dimen/record_item_width"
                    android:layout_height="@dimen/record_item_height"
                    android:background="@drawable/bg_radius_4_white10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10">

                    <TextView
                        android:id="@+id/tvXuhao"
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="序     号：" />

                    <TextView
                        android:id="@+id/tvNumber"
                        style="@style/text_normal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/record_item_width"
                    android:layout_height="@dimen/record_item_height"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/bg_radius_4_white10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10">

                    <TextView
                        android:id="@+id/tvDeviceTime"
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用时长：" />

                    <TextView
                        android:id="@+id/evDeviceTime"
                        style="@style/text_normal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/record_item_width"
                    android:layout_height="@dimen/record_item_height"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/bg_radius_4_white10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10">

                    <TextView
                        android:id="@+id/tvStartTime"
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开始时间：" />

                    <TextView
                        android:id="@+id/evStartTime"
                        style="@style/text_normal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/record_item_width"
                    android:layout_height="@dimen/record_item_height"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/bg_radius_4_white10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10">

                    <TextView
                        android:id="@+id/tvEndTime"
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="结束时间：" />

                    <TextView
                        android:id="@+id/evEndTime"
                        style="@style/text_normal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/record_item_width"
                    android:layout_height="@dimen/record_item_height"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/bg_radius_4_white10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10">

                    <TextView
                        android:id="@+id/tvAllTime"
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="累计工作时间：" />

                    <TextView
                        android:id="@+id/tvWorkAllTime"
                        style="@style/text_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/record_item_width"
                    android:layout_height="24.5dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/tvUp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="上一条"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        app:shape_radius="2dp"
                        app:shape_solidColor="#00000000"
                        app:shape_strokeColor="@color/white"
                        app:shape_strokeWidth="0.5dp" />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/tvDown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="下一条"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        app:shape_endColor="#A202FF"
                        app:shape_radius="2dp"
                        app:shape_startColor="#10A5F9" />

                </LinearLayout>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="24dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="20dp"
                    android:src="@mipmap/ic_machine"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="H,210:118"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.hjq.shape.layout.ShapeLinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/dp_10">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:paddingRight="32dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="12dp"
                android:visibility="gone"
                tools:text="@string/app_name" />


            <ImageView
                android:id="@+id/ivFinish"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="11dp"
                android:src="@mipmap/icon_w_finish" />
        </RelativeLayout>

    </LinearLayout>


</RelativeLayout>