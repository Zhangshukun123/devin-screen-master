<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/colorPrimary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.hjq.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            app:shape="rectangle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal">

                <com.hjq.shape.layout.ShapeLinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:shape="rectangle"
                    app:shape_radius="4dp"
                    app:shape_solidColor="#14D5B7FF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFrequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frequency"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/evFrequency"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center|end"
                            android:hint=" "
                            android:inputType="numberSigned"
                            android:textColor="@color/white"
                            android:textColorHint="#B9CCF9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvHz"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:text="HZ"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/divide" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvIntensity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Intensity"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rectangle"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="22dp"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_buttonairsettings" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/divide" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTreatmentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Treatment Time"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/evTreatmentTime"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center|end"
                            android:hint=" "
                            android:inputType="numberSigned"
                            android:textColor="@color/white"
                            android:textColorHint="#B9CCF9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMin"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:text="Min"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>

                </com.hjq.shape.layout.ShapeLinearLayout>

                <com.hjq.shape.view.ShapeTextView
                    android:id="@+id/tvSave"
                    android:layout_width="72dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:shape_endColor="#A202FF"
                    app:shape_radius="2dp"
                    app:shape_startColor="#10A5F9" />

                <LinearLayout
                    android:id="@+id/llPemfAuto"
                    android:layout_width="96dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAutoLabel"
                        android:layout_width="30dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="AUTO"
                        android:textColor="@color/white"
                        android:textSize="6sp" />

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/tvPemfAutoState"
                        android:layout_width="50dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="ON"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:shape_radius="2dp"
                        app:shape_solidColor="#10A5F9" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/ivRunning"
                android:layout_width="300dp"
                android:layout_height="120dp"
                android:layout_marginTop="14dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_running_false" />

            <com.hjq.shape.layout.ShapeLinearLayout
                android:id="@+id/btnPemfManual"
                android:layout_width="210dp"
                android:layout_height="34dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                app:shape_endColor="#A202FF"
                app:shape_radius="2dp"
                app:shape_startColor="#10A5F9">

                <ImageView
                    android:id="@+id/ivPemfManual"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@mipmap/ic_pemf_start" />

                <TextView
                    android:id="@+id/tvPemfManual"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="START"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </com.hjq.shape.layout.ShapeLinearLayout>

        </com.hjq.shape.layout.ShapeLinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
