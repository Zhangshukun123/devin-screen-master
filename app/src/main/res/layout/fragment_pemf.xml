<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/colorPrimary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.hjq.shape.layout.ShapeLinearLayout
            android:id="@+id/pemfContent"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            app:shape="rectangle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal">

                <com.hjq.shape.layout.ShapeLinearLayout
                    android:id="@+id/pemfSettingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    app:shape="rectangle"
                    app:shape_radius="4dp"
                    app:shape_solidColor="#14D5B7FF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFrequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frequency"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/evFrequency"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center|end"
                            android:hint=" "
                            android:inputType="numberSigned"
                            android:minWidth="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:textColor="@color/white"
                            android:textColorHint="#B9CCF9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvHz"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:text="HZ"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/divide" />

                    <LinearLayout
                        android:id="@+id/pemfIntensityRow"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvIntensity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Intensity"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <View
                            android:id="@+id/pemfIntensitySpacer"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rectangle"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_buttonairsettings" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/divide" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTreatmentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Treatment Time"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/evTreatmentTime"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center|end"
                            android:hint=" "
                            android:inputType="numberSigned"
                            android:minWidth="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:textColor="@color/white"
                            android:textColorHint="#B9CCF9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMin"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:text="Min"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>

                </com.hjq.shape.layout.ShapeLinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/ivRunning"
                android:layout_width="220dp"
                android:layout_height="88dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pemf_running_panel"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_running_false" />

            <RelativeLayout
                android:id="@+id/pemfControlsRow"
                android:layout_width="220dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <com.hjq.shape.layout.ShapeLinearLayout
                    android:id="@+id/btnPemfManual"
                    android:layout_width="88dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:shape_endColor="#A202FF"
                    app:shape_radius="2dp"
                    app:shape_startColor="#10A5F9">

                    <ImageView
                        android:id="@+id/ivPemfManual"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@mipmap/ic_pemf_start" />

                    <TextView
                        android:id="@+id/tvPemfManual"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="START"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </com.hjq.shape.layout.ShapeLinearLayout>

                <LinearLayout
                    android:id="@+id/llPemfAuto"
                    android:layout_width="88dp"
                    android:layout_height="26dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.hjq.shape.view.ShapeTextView
                        android:id="@+id/tvAutoLabel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="AUTO"
                        android:textColor="@color/white"
                        android:textSize="5sp"
                        app:shape_radius="12dp"
                        app:shape_strokeColor="#FFFFFFFF"
                        app:shape_strokeWidth="0.8dp" />

                    <FrameLayout
                        android:id="@+id/pemfAutoSwitchTrack"
                        android:layout_width="58dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_pemf_auto_track">

                        <com.hjq.shape.view.ShapeTextView
                            android:id="@+id/tvPemfAutoState"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="center"
                            android:text="ON"
                            android:textColor="@color/white"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            app:shape_radius="2dp"
                            app:shape_solidColor="#10A5F9" />

                    </FrameLayout>

                </LinearLayout>

            </RelativeLayout>

        </com.hjq.shape.layout.ShapeLinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
