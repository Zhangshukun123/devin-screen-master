<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_pagebg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/title_color">

        <ImageView
            android:id="@+id/ivFinish"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:paddingLeft="32dp"
            android:paddingVertical="12dp"
            android:src="@mipmap/icon_w_finish" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:paddingRight="32dp"
            android:text="301按摩室"
            android:textColor="@color/white"
            android:textSize="12dp" />   <ImageView
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:src="@mipmap/pic_titlelogo" />
    </RelativeLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="32dp">

        <net.center.blurview.ShapeBlurView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:blur_corner_radius="15dp"
            app:blur_overlay_color="@color/wight_color"
            app:blur_radius="5dp" />

        <ImageView
            android:layout_width="102dp"
            android:layout_height="92dp"
            android:layout_gravity="right|bottom"
            android:layout_margin="15dp"
            android:src="@mipmap/icon_wenzi" />

     
        
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            app:spanCount="3"
            android:id="@+id/languageList"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_height="wrap_content"/>
        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvSave"
            app:shape_radius="5dp"
            android:paddingHorizontal="33dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="25dp"
            android:gravity="center"
            android:text="保存"
            app:shape_solidColor="@color/white"
            app:shape_solidPressedColor="@color/bg_color" />

    </FrameLayout>
</LinearLayout>